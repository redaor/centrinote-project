# =====================================================
# CENTRINOTE - ENVIRONMENT VARIABLES EXAMPLE
# =====================================================

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ NEVER use VITE_* prefix for sensitive keys (exposed in browser)
# ✅ Backend-only variables (Netlify Functions, Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret for token generation
JWT_SECRET=your-jwt-secret-key

# =====================================================
# AUTHENTICATION CONFIGURATION
# =====================================================

# URLs for email confirmation
VITE_AUTH_CONFIRM_URL=https://your-domain.com/auth/confirm-email
VITE_AUTH_SIGNUP_URL=https://your-domain.com/auth/confirm-signup

# Disable automatic Supabase emails
VITE_SUPABASE_AUTH_EMAIL_CONFIRMATIONS=false
VITE_SUPABASE_AUTH_AUTO_CONFIRM=true

# Master API token for secure operations
MASTER_API_TOKEN=your-master-api-token

# =====================================================
# SMTP CONFIGURATION (IONOS)
# =====================================================

SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=contact@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Your App Name <contact@your-domain.com>

# =====================================================
# APPLICATION URLs
# =====================================================

VITE_APP_URL=https://your-domain.com

# API Base URL
# Dev: http://localhost:8888/.netlify/functions
# Prod: /.netlify/functions (relative)
VITE_API_BASE=/.netlify/functions

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# Direct connection (port 5432) for backend operations
DATABASE_URL=postgresql://postgres.your-project:password@aws-region.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-region.pooler.supabase.com:5432/postgres

# =====================================================
# STRIPE CONFIGURATION
# =====================================================

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
VITE_PRO_PRICE_ID=price_pro_id
VITE_Focus_ID=price_focus_id
VITE_Free_ID=price_free_id

# =====================================================
# OPENAI CONFIGURATION (Edge Functions & Netlify Functions)
# =====================================================

# ⚠️ SECURITY: OpenAI API Key must be set as Supabase secret (backend only)
# ❌ NEVER use VITE_OPENAI_API_KEY (would expose key in browser bundle)
# ✅ ALWAYS use Edge Function ai-chat to call OpenAI

# For Supabase Edge Functions, set the secrets using Supabase CLI:
# supabase secrets set OPENAI_API_KEY=sk-proj-your-actual-key
# supabase secrets set BRAVE_API_KEY=your-brave-search-key

# For Netlify Functions (transcribe-audio), set in Netlify Dashboard:
# Netlify Dashboard → Site Settings → Environment Variables
# OPENAI_API_KEY=sk-proj-your-actual-key

# ⚠️ IMPORTANT: BRAVE_API_KEY est REQUIS pour la recherche web d'actualités
# Sans cette clé, l'IA ne pourra pas répondre aux questions sur les actualités
# Obtenez votre clé Brave Search API sur: https://brave.com/search/api/

# Get your OpenAI key from: https://platform.openai.com/api-keys

# Usage:
# - Whisper API (transcription): ~$0.006 par minute
# - GPT-4 mini (résumés): ~$0.01 par résumé
# - GPT-4 (ai-chat): ~$0.03 par requête

# =====================================================
# N8N WEBHOOKS (Optional - for legacy integrations)
# =====================================================

VITE_N8N_WEBHOOK_URL=https://n8n.srv886297.hstgr.cloud
VITE_N8N_RECORDING=webhook/recording
VITE_N8N_MEETING_CREATED=webhook/meeting-created
VITE_N8N_MEETING_ENDED=webhook/meeting-ended
VITE_N8N_COLLABORATION=webhook/collaboration
VITE_N8N_STUDY_COMPLETED=webhook/study-completed
VITE_N8N_DISCUSSION_URL=https://your-n8n.com/webhook/discussion
VITE_N8N_AUTOMATION_URL=https://your-n8n.com/webhook/automation
VITE_N8N_ZOOM_WEBHOOK=https://your-n8n.com/webhook/zoom
VITE_N8N_GOOGLE_MEET_WEBHOOK=https://your-n8n.com/webhook/google-meet
VITE_N8N_CENTRINOTE_EVENTS=https://your-n8n.com/webhook/centrinote-events
VITE_N8N_DAILY_RECORDING=https://your-n8n-instance.com/webhook/daily-recording
VITE_N8N_DAILY_EVENTS=https://your-n8n-instance.com/webhook/daily-events
VITE_N8N_WEBHOOK_BASE=https://your-n8n.com

# =====================================================
# GOOGLE INTEGRATION
# =====================================================

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar

# =====================================================
# DAILY.CO CONFIGURATION (Video conferencing)
# =====================================================

VITE_DAILY_API_KEY=your-daily-api-key
DAILY_API_KEY=your-daily-api-key
VITE_DAILY_DOMAIN=your-domain.daily.co
DAILY_WEBHOOK_SECRET=your-daily-webhook-secret

# =====================================================
# AUTOMATION SYSTEM (Edge Functions)
# =====================================================

# Push Notifications Configuration
# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# Configuration for pg_cron (set in Supabase Dashboard)
# Settings → Database → Custom Postgres Configuration
# app.settings.supabase_url = https://your-project.supabase.co
# app.settings.supabase_service_role_key = your-service-role-key

# Micro Templates Configuration (optional)
# These are already set via SMTP config above, but listed here for reference
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM are used by micro templates

# =====================================================
# NETLIFY FUNCTIONS (Dashboard configuration)
# =====================================================
# Ces variables doivent être configurées sur le dashboard Netlify :
# DAILY_API_KEY=your_daily_api_key_here
# REACT_APP_DAILY_DOMAIN=your-domain.daily.co
# REACT_APP_N8N_RECORDING_WEBHOOK=https://your-n8n-instance.com/webhook/daily-recording
# REACT_APP_N8N_EVENTS_WEBHOOK=https://your-n8n-instance.com/webhook/daily-meeting-events
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =====================================================
# ADMIN FUNCTIONS SECURITY
# =====================================================

# Secret pour protéger les endpoints admin (/.netlify/functions/admin/*)
# Générer avec: openssl rand -hex 32
ADMIN_SECRET=your-random-32-character-secret-here

# ⚠️ CRITICAL: Ce secret doit être différent en dev et prod
# Dev:  Définir dans .env local
# Prod: Définir dans Netlify Dashboard → Site Settings → Environment Variables

# =====================================================
# DEPLOYMENT NOTES
# =====================================================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. For Supabase Edge Functions, set secrets using:
#    supabase secrets set SMTP_HOST=smtp.ionos.fr
#    supabase secrets set SMTP_PORT=465
#    supabase secrets set SMTP_USER=contact@your-domain.com
#    supabase secrets set SMTP_PASSWORD=your-password
#    supabase secrets set SMTP_FROM="Your App <contact@your-domain.com>"
#    supabase secrets set FCM_SERVER_KEY=your-fcm-key
# 4. For pg_cron configuration, use Supabase Dashboard SQL Editor:
#    ALTER DATABASE postgres SET app.settings.supabase_url = 'your-url';
#    ALTER DATABASE postgres SET app.settings.supabase_service_role_key = 'your-key';
# 5. Deploy Edge Functions:
#    supabase functions deploy automation-scheduler
#    supabase functions deploy automation-runner
#    supabase functions deploy automation-email
#    supabase functions deploy automation-notification

# =====================================================
# AUTOMATION SYSTEM TESTING
# =====================================================

# Test automation-scheduler:
# curl -X POST https://your-project.supabase.co/functions/v1/automation-scheduler \
#   -H "Authorization: Bearer YOUR_SERVICE_ROLE_KEY" \
#   -H "Content-Type: application/json"

# Test automation-runner:
# curl -X POST https://your-project.supabase.co/functions/v1/automation-runner \
#   -H "Authorization: Bearer YOUR_SERVICE_ROLE_KEY" \
#   -H "Content-Type: application/json" \
#   -d '{"automation_id": "UUID", "trigger_data": {"test": true}, "test_mode": true}'

# Test automation-email:
# curl -X POST https://your-project.supabase.co/functions/v1/automation-email \
#   -H "Authorization: Bearer YOUR_SERVICE_ROLE_KEY" \
#   -H "Content-Type: application/json" \
#   -d '{"to": "test@example.com", "subject": "Test", "body": "Test email"}'

# Test automation-notification:
# curl -X POST https://your-project.supabase.co/functions/v1/automation-notification \
#   -H "Authorization: Bearer YOUR_SERVICE_ROLE_KEY" \
#   -H "Content-Type: application/json" \
#   -d '{"user_id": "UUID", "title": "Test", "message": "Test notification"}'

# =====================================================
# AI CHAT SYSTEM (GPT-4)
# =====================================================

# Deploy ai-chat Edge Function:
# supabase functions deploy ai-chat --no-verify-jwt

# Set OpenAI API Key secret:
# supabase secrets set OPENAI_API_KEY=sk-proj-your-actual-openai-key

# Test ai-chat:
# curl -X POST https://your-project.supabase.co/functions/v1/ai-chat \
#   -H "Content-Type: application/json" \
#   -d '{"question": "Quelle date et heure est-il exactement ?"}'

# Features:
# - GPT-4 model with internet connectivity
# - Real-time date/time awareness (French timezone)
# - 5-minute cache for identical questions
# - 8-second timeout with fallback
# - Robust error handling
# - Target response time: < 1.5s
# - Target cost: < 0.01€ per request

# =====================================================
# AI ASSISTANT PLUGIN (Reformuler, Résumer, etc.)
# =====================================================

# Deploy ai-assistant Edge Function:
# supabase functions deploy ai-assistant

# Secrets requis (déjà configurés ci-dessus):
# - OPENAI_API_KEY (GPT-4o-mini)
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY

# Appliquer la migration SQL:
# supabase migration up

# Test ai-assistant:
# curl -X POST https://your-project.supabase.co/functions/v1/ai-assistant \
#   -H "Authorization: Bearer YOUR_JWT_TOKEN" \
#   -H "Content-Type: application/json" \
#   -d '{"action": "resumer", "text": "Votre texte ici..."}'

# Features:
# - 5 actions: reformuler, resumer, ameliorer, definir, rechercher
# - Rate-limit: 50 requêtes / 24h / utilisateur
# - PII stripper automatique (emails, téléphones, cartes)
# - Audit trail RGPD complet
# - Coût: ~0.001€ par requête