# Variables d'environnement pour noteo-orchestrator
# Copier ce fichier en .env et remplir avec vos vraies clés

# Clé OpenAI pour la recherche sémantique
OPENAI_SEARCH_KEY=sk-proj-xxx...

# Clé OpenAI pour le chat conversationnel
OPENAI_CHAT_KEY=sk-proj-yyy...

# Clé OpenAI pour l'aide guidée
OPENAI_AIDE_KEY=sk-proj-zzz...
