{
  "name": "Zoom Fireflies-like Enhanced",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zoom-webhook-handler",
        "responseMode": "responseNode"
      },
      "id": "zoom-webhook-trigger",
      "name": "Zoom Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "zoom-webhook-handler"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event }}",
              "operation": "equal",
              "value2": "meeting.started"
            }
          ]
        }
      },
      "id": "meeting-started-check",
      "name": "Meeting Started?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event }}",
              "operation": "equal",
              "value2": "recording.completed"
            }
          ]
        }
      },
      "id": "recording-completed-check", 
      "name": "Recording Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event }}",
              "operation": "equal",
              "value2": "meeting.ended"
            }
          ]
        }
      },
      "id": "meeting-ended-check",
      "name": "Meeting Ended?", 
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE zoom_meetings SET status = 'started', started_at = NOW() WHERE meeting_id = $1",
        "additionalFields": {
          "queryParameters": "={{ [$json.payload.object.id] }}"
        }
      },
      "id": "update-meeting-started",
      "name": "Update Meeting Started",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [680, 200],
      "credentials": {
        "postgres": {
          "id": "supabase-db",
          "name": "Supabase DB"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.payload.object.recording_files[0].download_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "httpHeaderAuth": "zoom-jwt-token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $('Get User Token').item.json.access_token }}"
            }
          ]
        }
      },
      "id": "download-recording",
      "name": "Download Recording",
      "type": "n8n-nodes-base.httpRequest", 
      "typeVersion": 3,
      "position": [680, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO zoom_recordings (meeting_id, recording_url, file_size, download_url, status, created_at) VALUES ($1, $2, $3, $4, 'downloaded', NOW())",
        "additionalFields": {
          "queryParameters": "={{ [\n  $json.payload.object.id,\n  $json.payload.object.recording_files[0].play_url,\n  $json.payload.object.recording_files[0].file_size,\n  $json.payload.object.recording_files[0].download_url\n] }}"
        }
      },
      "id": "store-recording-info",
      "name": "Store Recording Info",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [900, 400],
      "credentials": {
        "postgres": {
          "id": "supabase-db",
          "name": "Supabase DB"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth", 
        "httpHeaderAuth": "openai-api-key",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization", 
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "multipart/form-data"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $('Download Recording').item.binary.data }}"
            },
            {
              "name": "model",
              "value": "whisper-1"
            },
            {
              "name": "language",
              "value": "fr"
            }
          ]
        }
      },
      "id": "transcribe-recording",
      "name": "Transcribe Recording",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery", 
        "query": "UPDATE zoom_recordings SET transcription = $1, transcription_status = 'completed' WHERE meeting_id = $2",
        "additionalFields": {
          "queryParameters": "={{ [\n  $json.text,\n  $('Zoom Webhook Trigger').item.json.payload.object.id\n] }}"
        }
      },
      "id": "store-transcription",
      "name": "Store Transcription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1340, 400],
      "credentials": {
        "postgres": {
          "id": "supabase-db",
          "name": "Supabase DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE zoom_meetings SET status = 'ended', ended_at = NOW() WHERE meeting_id = $1",
        "additionalFields": {
          "queryParameters": "={{ [$json.payload.object.id] }}"
        }
      },
      "id": "update-meeting-ended",
      "name": "Update Meeting Ended", 
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [680, 600],
      "credentials": {
        "postgres": {
          "id": "supabase-db",
          "name": "Supabase DB"  
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"event\": $json.event, \"processed_at\": $now.toISO() } }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Zoom Webhook Trigger": {
      "main": [
        [
          {
            "node": "Meeting Started?",
            "type": "main", 
            "index": 0
          },
          {
            "node": "Recording Completed?",
            "type": "main",
            "index": 0  
          },
          {
            "node": "Meeting Ended?",
            "type": "main",
